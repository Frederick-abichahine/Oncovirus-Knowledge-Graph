        <rdfs:range rdf:resource="http://knowdive.disi.unitn.it/etype#string"/>
        <etype:comment rdf:datatype="http://knowdive.disi.unitn.it/etype#string">Name of the biological pathway.</etype:comment>
        <etype:isDefinedBy rdf:resource="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C164895"/>
        <etype:label rdf:datatype="http://knowdive.disi.unitn.it/etype#string">pathwayName</etype:label>
    </owl:DatatypeProperty>
    


