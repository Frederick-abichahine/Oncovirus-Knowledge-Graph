        <etype:isDefinedBy rdf:resource="http://edamontology.org/data_2592"/>
        <etype:label rdf:datatype="http://knowdive.disi.unitn.it/etype#PlainLiteral">cancerType</etype:label>
    </owl:DatatypeProperty>
    


