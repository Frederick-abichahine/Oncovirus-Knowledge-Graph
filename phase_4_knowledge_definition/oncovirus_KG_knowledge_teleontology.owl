        <rdfs:range rdf:resource="http://knowdive.disi.unitn.it/etype#string"/>
        <etype:comment rdf:datatype="http://knowdive.disi.unitn.it/etype#string">An animal or plant that nourishes and supports a parasite; it does not benefit and is often harmed by the association.</etype:comment>
        <etype:isDefinedBy rdf:datatype="http://knowdive.disi.unitn.it/etype#string">UKC-6810</etype:isDefinedBy>
        <etype:label rdf:datatype="http://knowdive.disi.unitn.it/etype#string">host</etype:label>
    </owl:DatatypeProperty>
    


