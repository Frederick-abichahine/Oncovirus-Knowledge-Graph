<?xml version="1.0"?>
<rdf:RDF xmlns="https://w3id.org/oncovirus-kg#"
     xml:base="https://w3id.org/oncovirus-kg"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:webprotege="http://webprotege.stanford.edu/">
    <owl:Ontology rdf:about="https://w3id.org/oncovirus-kg"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Annotation properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://webprotege.stanford.edu/RmcJVez4zUo3FTofO4oCKw -->

    <owl:AnnotationProperty rdf:about="http://webprotege.stanford.edu/RmcJVez4zUo3FTofO4oCKw">
        <rdfs:label>conceptD</rdfs:label>
    </owl:AnnotationProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- https://w3id.org/oncovirus-kg#causes -->

    <owl:ObjectProperty rdf:about="https://w3id.org/oncovirus-kg#causes">
        <rdfs:domain rdf:resource="https://w3id.org/oncovirus-kg#Virus"/>
        <rdfs:range rdf:resource="https://w3id.org/oncovirus-kg#Cancer"/>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Give rise to; cause to happen or occur, not always intentionally</rdfs:comment>
        <rdfs:isDefinedBy rdf:datatype="http://www.w3.org/2001/XMLSchema#string">UKC-100755</rdfs:isDefinedBy>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">causes</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/oncovirus-kg#encodes -->

    <owl:ObjectProperty rdf:about="https://w3id.org/oncovirus-kg#encodes">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/oncovirus-kg#Virus"/>
        <rdfs:range rdf:resource="https://w3id.org/oncovirus-kg#ViralProtein"/>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents that a genetic element (such as a gene, transcript, or genomic region) of an organism specifies the sequence or structure of a functional product, typically a protein or RNA molecule. The relationship links the genetic source (subject) to the resulting biological product (object).</rdfs:comment>
        <rdfs:isDefinedBy rdf:datatype="http://www.w3.org/2001/XMLSchema#string">OKG25-17</rdfs:isDefinedBy>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">encodes</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/oncovirus-kg#hasAnnotation -->

    <owl:ObjectProperty rdf:about="https://w3id.org/oncovirus-kg#hasAnnotation">
        <rdfs:domain rdf:resource="https://w3id.org/oncovirus-kg#HostProtein"/>
        <rdfs:domain rdf:resource="https://w3id.org/oncovirus-kg#ViralProtein"/>
        <rdfs:range rdf:resource="https://w3id.org/oncovirus-kg#ProteinAnnotation"/>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Links an entity to a descriptive annotation or metadata.</rdfs:comment>
        <rdfs:isDefinedBy rdf:datatype="http://www.w3.org/2001/XMLSchema#string">OKG25-20</rdfs:isDefinedBy>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">hasAnnotation</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/oncovirus-kg#hasPhenotype -->

    <owl:ObjectProperty rdf:about="https://w3id.org/oncovirus-kg#hasPhenotype">
        <rdfs:domain rdf:resource="https://w3id.org/oncovirus-kg#Virus"/>
        <rdfs:range rdf:resource="https://w3id.org/oncovirus-kg#Phenotype"/>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Links an entity to an observed trait, characteristic, or phenotype.</rdfs:comment>
        <rdfs:isDefinedBy rdf:datatype="http://www.w3.org/2001/XMLSchema#string">OKG25-21</rdfs:isDefinedBy>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">hasPhenotype</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/oncovirus-kg#interactsWith -->

    <owl:ObjectProperty rdf:about="https://w3id.org/oncovirus-kg#interactsWith">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/oncovirus-kg#ViralProtein"/>
        <rdfs:range rdf:resource="https://w3id.org/oncovirus-kg#HostProtein"/>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Denotes that two entities engage in a direct or measurable interaction, influencing each other’s state, function, or behavior. This relationship is typically symmetric, reflecting mutual participation in the interaction.</rdfs:comment>
        <rdfs:isDefinedBy rdf:datatype="http://www.w3.org/2001/XMLSchema#string">OKG25-19</rdfs:isDefinedBy>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">interactsWith</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/oncovirus-kg#involvedIn -->

    <owl:ObjectProperty rdf:about="https://w3id.org/oncovirus-kg#involvedIn">
        <rdfs:domain rdf:resource="https://w3id.org/oncovirus-kg#HostProtein"/>
        <rdfs:range rdf:resource="https://w3id.org/oncovirus-kg#Pathway"/>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Indicates that an entity participates in, contributes to, or plays a role within a process, event, pathway, or higher-level activity. The relationship is generally directional, linking the participating entity (subject) to the broader process or context (object).</rdfs:comment>
        <rdfs:isDefinedBy rdf:datatype="http://www.w3.org/2001/XMLSchema#string">OKG25-18</rdfs:isDefinedBy>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">involvedIn</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/oncovirus-kg#targets -->

    <owl:ObjectProperty rdf:about="https://w3id.org/oncovirus-kg#targets">
        <rdfs:domain rdf:resource="https://w3id.org/oncovirus-kg#Vaccine"/>
        <rdfs:range rdf:resource="https://w3id.org/oncovirus-kg#Virus"/>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Intend (something) to move towards a certain goal.</rdfs:comment>
        <rdfs:isDefinedBy rdf:datatype="http://www.w3.org/2001/XMLSchema#string">UKC-98182</rdfs:isDefinedBy>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">targets</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Data properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://webprotege.stanford.edu/R7qxZANCjajiQ3pjEstO9q0 -->

    <owl:DatatypeProperty rdf:about="http://webprotege.stanford.edu/R7qxZANCjajiQ3pjEstO9q0">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Identifier of a pathway from the KEGG pathway database.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://edamontology.org/data_2343"/>
        <rdfs:label>pathwayKeggID</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://webprotege.stanford.edu/R8ASqI7TyzGj1ySm9YxepFg -->

    <owl:DatatypeProperty rdf:about="http://webprotege.stanford.edu/R8ASqI7TyzGj1ySm9YxepFg">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Unique Uniprot Reference to the host protein.</rdfs:comment>
        <rdfs:isDefinedBy rdf:datatype="http://www.w3.org/2001/XMLSchema#string">OKG25-12</rdfs:isDefinedBy>
        <rdfs:label>hostUniprotID</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://webprotege.stanford.edu/R8bPytAlDLGpWXYgZ0S1W3z -->

    <owl:DatatypeProperty rdf:about="http://webprotege.stanford.edu/R8bPytAlDLGpWXYgZ0S1W3z">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A type (represented as a string) of cancer.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://edamontology.org/data_2592"/>
        <rdfs:label>cancerType</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://webprotege.stanford.edu/R8cbhrGGAmVUiNhKPGvOIXf -->

    <owl:DatatypeProperty rdf:about="http://webprotege.stanford.edu/R8cbhrGGAmVUiNhKPGvOIXf">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An identifier of a polypeptide in the UniProt database.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://edamontology.org/data_2291"/>
        <rdfs:label>uniprotID</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://webprotege.stanford.edu/R91hxUhnmf9eykE2vNC0iTi -->

    <owl:DatatypeProperty rdf:about="http://webprotege.stanford.edu/R91hxUhnmf9eykE2vNC0iTi">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The broad functional class or grouping of a biological pathway.</rdfs:comment>
        <rdfs:isDefinedBy rdf:datatype="http://www.w3.org/2001/XMLSchema#string">OKG25-9</rdfs:isDefinedBy>
        <rdfs:label>pathwayCategory</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://webprotege.stanford.edu/R95avDRXjCRQmhtfTcPut6N -->

    <owl:DatatypeProperty rdf:about="http://webprotege.stanford.edu/R95avDRXjCRQmhtfTcPut6N">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A brief explanation of what the vaccine does and what it targets or prevents.</rdfs:comment>
        <rdfs:isDefinedBy rdf:datatype="http://www.w3.org/2001/XMLSchema#string">OKG25-05</rdfs:isDefinedBy>
        <rdfs:label>vaccineDescription</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://webprotege.stanford.edu/RBdeB3faqYgc5M5kUKo1mKC -->

    <owl:DatatypeProperty rdf:about="http://webprotege.stanford.edu/RBdeB3faqYgc5M5kUKo1mKC">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#anyURI"/>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The origin, database, or reference from which vaccine information is obtained.</rdfs:comment>
        <rdfs:isDefinedBy rdf:datatype="http://www.w3.org/2001/XMLSchema#string">OKG25-06</rdfs:isDefinedBy>
        <rdfs:label>vaccineSource</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://webprotege.stanford.edu/RVX8PXlv0Bb8jaRtprWjZb -->

    <owl:DatatypeProperty rdf:about="http://webprotege.stanford.edu/RVX8PXlv0Bb8jaRtprWjZb">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Describes the category or classification of a virus.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://purl.bioontology.org/ontology/SNOMEDCT/277234002"/>
        <rdfs:label>virusType</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://webprotege.stanford.edu/RZFBE3JmJ7VksWNmYfhdYb -->

    <owl:DatatypeProperty rdf:about="http://webprotege.stanford.edu/RZFBE3JmJ7VksWNmYfhdYb">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Unique Uniprot Reference to the viral protein.</rdfs:comment>
        <rdfs:isDefinedBy rdf:datatype="http://www.w3.org/2001/XMLSchema#string">OKG25-11</rdfs:isDefinedBy>
        <rdfs:label>viralUniprotID</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://webprotege.stanford.edu/Rr66SjY9htiofDCiuF8EwJ -->

    <owl:DatatypeProperty rdf:about="http://webprotege.stanford.edu/Rr66SjY9htiofDCiuF8EwJ">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#anyURI"/>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The source or reference documenting the described phenotype.</rdfs:comment>
        <rdfs:isDefinedBy rdf:datatype="http://www.w3.org/2001/XMLSchema#string">OKG25-08</rdfs:isDefinedBy>
        <rdfs:label>phenotypeSource</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/oncovirus-kg#cancerID -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/oncovirus-kg#cancerID">
        <rdfs:domain rdf:resource="https://w3id.org/oncovirus-kg#Cancer"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Unique identifier for the cancer record.</rdfs:comment>
        <rdfs:isDefinedBy rdf:datatype="http://www.w3.org/2001/XMLSchema#string">OKG25-02</rdfs:isDefinedBy>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">cancerID</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/oncovirus-kg#function -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/oncovirus-kg#function">
        <rdfs:domain rdf:resource="https://w3id.org/oncovirus-kg#ProteinAnnotation"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Serve a purpose, role, or function.</rdfs:comment>
        <rdfs:isDefinedBy rdf:datatype="http://www.w3.org/2001/XMLSchema#string">UKC-105757</rdfs:isDefinedBy>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">function</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/oncovirus-kg#host -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/oncovirus-kg#host">
        <rdfs:domain rdf:resource="https://w3id.org/oncovirus-kg#Virus"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An animal or plant that nourishes and supports a parasite; it does not benefit and is often harmed by the association.</rdfs:comment>
        <rdfs:isDefinedBy rdf:datatype="http://www.w3.org/2001/XMLSchema#string">UKC-6810</rdfs:isDefinedBy>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">host</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/oncovirus-kg#hostGeneName -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/oncovirus-kg#hostGeneName">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topDataProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/oncovirus-kg#HostProtein"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Standard name assigned to a host gene.</rdfs:comment>
        <rdfs:isDefinedBy rdf:datatype="http://www.w3.org/2001/XMLSchema#string">OKG25-14</rdfs:isDefinedBy>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">hostGeneName</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/oncovirus-kg#hostProteinName -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/oncovirus-kg#hostProteinName">
        <rdfs:domain rdf:resource="https://w3id.org/oncovirus-kg#HostProtein"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Official or common name of a host protein.</rdfs:comment>
        <rdfs:isDefinedBy rdf:datatype="http://www.w3.org/2001/XMLSchema#string">OKG25-16</rdfs:isDefinedBy>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">hostProteinName</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/oncovirus-kg#localization -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/oncovirus-kg#localization">
        <rdfs:domain rdf:resource="https://w3id.org/oncovirus-kg#ProteinAnnotation"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A determination of the place where something is.</rdfs:comment>
        <rdfs:isDefinedBy rdf:datatype="http://www.w3.org/2001/XMLSchema#string">UKC-695</rdfs:isDefinedBy>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">localization</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/oncovirus-kg#organismName -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/oncovirus-kg#organismName">
        <rdfs:domain rdf:resource="https://w3id.org/oncovirus-kg#Virus"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The name of an organism (or group of organisms).</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://edamontology.org/data_2909"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">organismName</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/oncovirus-kg#pathwayDescription -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/oncovirus-kg#pathwayDescription">
        <rdfs:domain rdf:resource="https://w3id.org/oncovirus-kg#Pathway"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A brief explanation of what a pathway does or represents.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C164893"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">pathwayDescription</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/oncovirus-kg#pathwayName -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/oncovirus-kg#pathwayName">
        <rdfs:domain rdf:resource="https://w3id.org/oncovirus-kg#Pathway"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Name of the biological pathway.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C164895"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">pathwayName</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/oncovirus-kg#pathwaySource -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/oncovirus-kg#pathwaySource">
        <rdfs:domain rdf:resource="https://w3id.org/oncovirus-kg#Pathway"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#anyURI"/>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The origin, database, or reference providing the pathway information.</rdfs:comment>
        <rdfs:isDefinedBy rdf:datatype="http://www.w3.org/2001/XMLSchema#string">OKG25-10</rdfs:isDefinedBy>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">pathwaySource</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/oncovirus-kg#phenotypeID -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/oncovirus-kg#phenotypeID">
        <rdfs:domain rdf:resource="https://w3id.org/oncovirus-kg#Phenotype"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Unique identifier for the virus phenotype record.</rdfs:comment>
        <rdfs:isDefinedBy rdf:datatype="http://www.w3.org/2001/XMLSchema#string">OKG25-07</rdfs:isDefinedBy>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">phenotypeID</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/oncovirus-kg#primarySite -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/oncovirus-kg#primarySite">
        <rdfs:domain rdf:resource="https://w3id.org/oncovirus-kg#Cancer"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Primary Site / Anatomical site or primary location associated with the cancer type.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://sbmi.uth.tmc.edu/ontology/ochv#C0449695"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">primarySite</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/oncovirus-kg#species -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/oncovirus-kg#species">
        <rdfs:domain rdf:resource="https://w3id.org/oncovirus-kg#Virus"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The name of a species (typically a taxonomic group) of organism.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://edamontology.org/data_1045"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">species</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/oncovirus-kg#trait -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/oncovirus-kg#trait">
        <rdfs:domain rdf:resource="https://w3id.org/oncovirus-kg#Phenotype"/>
