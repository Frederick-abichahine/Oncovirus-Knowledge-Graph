    <!-- http://knowdive.disi.unitn.it/etype#has_vaccineID -->

    <owl:DatatypeProperty rdf:about="http://knowdive.disi.unitn.it/etype#has_vaccineID">
        <rdfs:domain rdf:resource="http://knowdive.disi.unitn.it/etype#Vaccine"/>
        <rdfs:range rdf:resource="http://knowdive.disi.unitn.it/etype#integer"/>
