    </owl:Class>
    


    <!-- https://w3id.org/oncovirus-kg#Vaccine -->

    <owl:Class rdf:about="https://w3id.org/oncovirus-kg#Vaccine">
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Immunogen consisting of a suspension of weakened or dead pathogenic cells injected in order to stimulate the production of antibodies.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/VO_0000001"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Vaccine</rdfs:label>
