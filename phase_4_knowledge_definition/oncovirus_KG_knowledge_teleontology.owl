        <rdfs:range rdf:resource="http://knowdive.disi.unitn.it/etype#anyURI"/>
        <etype:comment rdf:datatype="http://knowdive.disi.unitn.it/etype#string">The source or reference documenting the described phenotype.</etype:comment>
        <etype:isDefinedBy rdf:datatype="http://knowdive.disi.unitn.it/etype#string">OKG25-08</etype:isDefinedBy>
        <etype:label rdf:datatype="http://knowdive.disi.unitn.it/etype#PlainLiteral">phenotypeSource</etype:label>
    </owl:DatatypeProperty>
    


