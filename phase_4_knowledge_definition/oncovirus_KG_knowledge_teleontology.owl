<?xml version="1.0"?>
<rdf:RDF xmlns="https://w3id.org/oncovirus-kg#"
     xml:base="https://w3id.org/oncovirus-kg"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:etype="http://knowdive.disi.unitn.it/etype#">
    <owl:Ontology rdf:about="https://w3id.org/oncovirus-kg">
        <owl:versionIRI rdf:resource="http://knowdive.disi.unitn.it/etype#"/>
    </owl:Ontology>
    


