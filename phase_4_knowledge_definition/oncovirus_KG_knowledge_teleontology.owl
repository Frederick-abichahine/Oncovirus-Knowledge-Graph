        <rdfs:domain rdf:resource="http://knowdive.disi.unitn.it/etype#Pathway"/>
        <rdfs:range rdf:resource="http://knowdive.disi.unitn.it/etype#anyURI"/>
        <etype:comment rdf:datatype="http://knowdive.disi.unitn.it/etype#string">The origin, database, or reference providing the pathway information.</etype:comment>
        <etype:isDefinedBy rdf:datatype="http://knowdive.disi.unitn.it/etype#string">OKG25-10</etype:isDefinedBy>
        <etype:label rdf:datatype="http://knowdive.disi.unitn.it/etype#string">pathwaySource</etype:label>
    </owl:DatatypeProperty>
    


