        <etype:isDefinedBy rdf:datatype="http://knowdive.disi.unitn.it/etype#string">OKG25-02</etype:isDefinedBy>
        <etype:label rdf:datatype="http://knowdive.disi.unitn.it/etype#string">cancerID</etype:label>
    </owl:DatatypeProperty>
    


