    <!-- http://knowdive.disi.unitn.it/etype#anyURI -->

    <rdfs:Datatype rdf:about="http://knowdive.disi.unitn.it/etype#anyURI"/>
    


    <!-- http://knowdive.disi.unitn.it/etype#integer -->

    <rdfs:Datatype rdf:about="http://knowdive.disi.unitn.it/etype#integer"/>
    


    <!-- http://knowdive.disi.unitn.it/etype#string -->

    <rdfs:Datatype rdf:about="http://knowdive.disi.unitn.it/etype#string"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://knowdive.disi.unitn.it/etype#has_causes -->

    <owl:ObjectProperty rdf:about="http://knowdive.disi.unitn.it/etype#has_causes">
        <rdfs:domain rdf:resource="http://knowdive.disi.unitn.it/etype#Virus"/>
        <rdfs:range rdf:resource="http://knowdive.disi.unitn.it/etype#Cancer"/>
        <etype:comment rdf:datatype="http://knowdive.disi.unitn.it/etype#string">Give rise to; cause to happen or occur, not always intentionally</etype:comment>
        <etype:isDefinedBy rdf:datatype="http://knowdive.disi.unitn.it/etype#string">UKC-100755</etype:isDefinedBy>
        <etype:label rdf:datatype="http://knowdive.disi.unitn.it/etype#string">causes</etype:label>
    </owl:ObjectProperty>
    


    <!-- http://knowdive.disi.unitn.it/etype#has_encodes -->

    <owl:ObjectProperty rdf:about="http://knowdive.disi.unitn.it/etype#has_encodes">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://knowdive.disi.unitn.it/etype#Virus"/>
        <rdfs:range rdf:resource="http://knowdive.disi.unitn.it/etype#ViralProtein"/>
        <etype:comment rdf:datatype="http://knowdive.disi.unitn.it/etype#string">Represents that a genetic element (such as a gene, transcript, or genomic region) of an organism specifies the sequence or structure of a functional product, typically a protein or RNA molecule. The relationship links the genetic source (subject) to the resulting biological product (object).</etype:comment>
        <etype:isDefinedBy rdf:datatype="http://www.w3.org/2001/XMLSchema#string">OKG25-22</etype:isDefinedBy>
        <etype:label rdf:datatype="http://knowdive.disi.unitn.it/etype#string">encodes</etype:label>
    </owl:ObjectProperty>
    


    <!-- http://knowdive.disi.unitn.it/etype#has_hasAnnotation -->

    <owl:ObjectProperty rdf:about="http://knowdive.disi.unitn.it/etype#has_hasAnnotation">
        <rdfs:domain rdf:resource="http://knowdive.disi.unitn.it/etype#HostProtein"/>
        <rdfs:range rdf:resource="http://knowdive.disi.unitn.it/etype#ProteinAnnotation"/>
        <etype:comment rdf:datatype="http://knowdive.disi.unitn.it/etype#string">Links an entity to a descriptive annotation or metadata.</etype:comment>
        <etype:isDefinedBy rdf:datatype="http://knowdive.disi.unitn.it/etype#string">OKG25-20</etype:isDefinedBy>
        <etype:label rdf:datatype="http://knowdive.disi.unitn.it/etype#string">hasAnnotation</etype:label>
    </owl:ObjectProperty>
    


    <!-- http://knowdive.disi.unitn.it/etype#has_hasPhenotype -->

    <owl:ObjectProperty rdf:about="http://knowdive.disi.unitn.it/etype#has_hasPhenotype">
        <rdfs:domain rdf:resource="http://knowdive.disi.unitn.it/etype#Virus"/>
        <rdfs:range rdf:resource="http://knowdive.disi.unitn.it/etype#Phenotype"/>
        <etype:comment rdf:datatype="http://knowdive.disi.unitn.it/etype#string">Links an entity to an observed trait, characteristic, or phenotype.</etype:comment>
        <etype:isDefinedBy rdf:datatype="http://knowdive.disi.unitn.it/etype#string">OKG25-21</etype:isDefinedBy>
        <etype:label rdf:datatype="http://knowdive.disi.unitn.it/etype#string">hasPhenotype</etype:label>
    </owl:ObjectProperty>
    


    <!-- http://knowdive.disi.unitn.it/etype#has_interactsWith -->

    <owl:ObjectProperty rdf:about="http://knowdive.disi.unitn.it/etype#has_interactsWith">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
        <rdfs:domain rdf:resource="http://knowdive.disi.unitn.it/etype#ViralProtein"/>
        <rdfs:range rdf:resource="http://knowdive.disi.unitn.it/etype#HostProtein"/>
        <etype:comment rdf:datatype="http://knowdive.disi.unitn.it/etype#string">Denotes that two entities engage in a direct or measurable interaction, influencing each other’s state, function, or behavior. This relationship is typically symmetric, reflecting mutual participation in the interaction.</etype:comment>
        <etype:isDefinedBy rdf:datatype="http://knowdive.disi.unitn.it/etype#string">OKG25-19</etype:isDefinedBy>
        <etype:label rdf:datatype="http://knowdive.disi.unitn.it/etype#string">interactsWith</etype:label>
    </owl:ObjectProperty>
    


    <!-- http://knowdive.disi.unitn.it/etype#has_involvedIn -->

    <owl:ObjectProperty rdf:about="http://knowdive.disi.unitn.it/etype#has_involvedIn">
        <rdfs:domain rdf:resource="http://knowdive.disi.unitn.it/etype#HostProtein"/>
        <rdfs:range rdf:resource="http://knowdive.disi.unitn.it/etype#Pathway"/>
        <etype:comment rdf:datatype="http://knowdive.disi.unitn.it/etype#string">Indicates that an entity participates in, contributes to, or plays a role within a process, event, pathway, or higher-level activity. The relationship is generally directional, linking the participating entity (subject) to the broader process or context (object).</etype:comment>
        <etype:isDefinedBy rdf:datatype="http://knowdive.disi.unitn.it/etype#string">OKG25-18</etype:isDefinedBy>
        <etype:label rdf:datatype="http://knowdive.disi.unitn.it/etype#string">involvedIn</etype:label>
    </owl:ObjectProperty>
    


    <!-- http://knowdive.disi.unitn.it/etype#has_targets -->

    <owl:ObjectProperty rdf:about="http://knowdive.disi.unitn.it/etype#has_targets">
        <rdfs:domain rdf:resource="http://knowdive.disi.unitn.it/etype#Vaccine"/>
        <rdfs:range rdf:resource="http://knowdive.disi.unitn.it/etype#Virus"/>
        <etype:comment rdf:datatype="http://knowdive.disi.unitn.it/etype#string">Intend (something) to move towards a certain goal.</etype:comment>
        <etype:isDefinedBy rdf:datatype="http://knowdive.disi.unitn.it/etype#string">UKC-98182</etype:isDefinedBy>
        <etype:label rdf:datatype="http://knowdive.disi.unitn.it/etype#string">targets</etype:label>
    </owl:ObjectProperty>
    


