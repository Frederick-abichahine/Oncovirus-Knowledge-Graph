    <!-- http://knowdive.disi.unitn.it/etype#isDefinedBy -->

    <owl:AnnotationProperty rdf:about="http://knowdive.disi.unitn.it/etype#isDefinedBy"/>
    


    <!-- http://knowdive.disi.unitn.it/etype#label -->

    <owl:AnnotationProperty rdf:about="http://knowdive.disi.unitn.it/etype#label"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Datatypes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://knowdive.disi.unitn.it/etype#PlainLiteral -->

