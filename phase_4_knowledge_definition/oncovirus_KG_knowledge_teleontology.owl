        <rdfs:range rdf:resource="http://knowdive.disi.unitn.it/etype#integer"/>
        <etype:comment rdf:datatype="http://knowdive.disi.unitn.it/etype#string">Unique identifier for the virus phenotype record.</etype:comment>
        <etype:isDefinedBy rdf:datatype="http://knowdive.disi.unitn.it/etype#string">OKG25-07</etype:isDefinedBy>
        <etype:label rdf:datatype="http://knowdive.disi.unitn.it/etype#string">phenotypeID</etype:label>
