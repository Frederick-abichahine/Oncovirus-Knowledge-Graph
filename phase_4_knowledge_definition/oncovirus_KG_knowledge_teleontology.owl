    <!-- http://knowdive.disi.unitn.it/etype#Cancer -->

    <owl:Class rdf:about="http://knowdive.disi.unitn.it/etype#Cancer">
        <etype:comment rdf:datatype="http://knowdive.disi.unitn.it/etype#string">Any malignant growth or tumor caused by abnormal and uncontrolled cell division; it may spread to other parts of the body through the lymphatic system or the blood stream.</etype:comment>
        <etype:label rdf:datatype="http://knowdive.disi.unitn.it/etype#string">Cancer</etype:label>
        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/DOID_162"/>
    </owl:Class>
    


    <!-- http://knowdive.disi.unitn.it/etype#HostProtein -->

    <owl:Class rdf:about="http://knowdive.disi.unitn.it/etype#HostProtein">
        <etype:comment rdf:datatype="http://knowdive.disi.unitn.it/etype#string">A protein that is produced by a host.</etype:comment>
        <etype:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/IDOMAL_0001068"/>
        <etype:label rdf:datatype="http://knowdive.disi.unitn.it/etype#string">HostProtein</etype:label>
    </owl:Class>
    


    <!-- http://knowdive.disi.unitn.it/etype#Pathway -->

    <owl:Class rdf:about="http://knowdive.disi.unitn.it/etype#Pathway">
        <etype:comment rdf:datatype="http://knowdive.disi.unitn.it/etype#string">A set or series of interactions, often forming a network, which biologists have found useful to group together for organizational, historic, biophysical or other reasons. Usage: Pathways can be used for demarcating any subnetwork of a BioPAX model. It is also possible to define a pathway without specifying the interactions within the pathway. In this case, the pathway instance could consist simply of a name and could be treated as a &apos;black box&apos;. Pathways can overlap, i.e. a single interaction might belong to multiple pathways. Pathways can also contain sub-pathways. Synonyms: network, module, cascade, Examples: glycolysis, valine biosynthesis, EGFR signaling.</etype:comment>
        <etype:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/PW_0000001"/>
        <etype:label rdf:datatype="http://knowdive.disi.unitn.it/etype#string">Pathway</etype:label>
    </owl:Class>
    


    <!-- http://knowdive.disi.unitn.it/etype#Phenotype -->

    <owl:Class rdf:about="http://knowdive.disi.unitn.it/etype#Phenotype">
        <etype:comment rdf:datatype="http://knowdive.disi.unitn.it/etype#string">What an organism looks like as a consequence of the interaction of its genotype and the environment.</etype:comment>
        <etype:isDefinedBy rdf:datatype="http://knowdive.disi.unitn.it/etype#string">UKC-26778</etype:isDefinedBy>
        <etype:label rdf:datatype="http://knowdive.disi.unitn.it/etype#string">Phenotype</etype:label>
    </owl:Class>
    


    <!-- http://knowdive.disi.unitn.it/etype#ProteinAnnotation -->

    <owl:Class rdf:about="http://knowdive.disi.unitn.it/etype#ProteinAnnotation">
        <etype:comment rdf:datatype="http://knowdive.disi.unitn.it/etype#string">Additional information and metadata on proteins.</etype:comment>
        <etype:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/COMO_0000067"/>
        <etype:label rdf:datatype="http://knowdive.disi.unitn.it/etype#string">ProteinAnnotation</etype:label>
    </owl:Class>
    


    <!-- http://knowdive.disi.unitn.it/etype#Vaccine -->

    <owl:Class rdf:about="http://knowdive.disi.unitn.it/etype#Vaccine">
        <etype:comment rdf:datatype="http://knowdive.disi.unitn.it/etype#string">Immunogen consisting of a suspension of weakened or dead pathogenic cells injected in order to stimulate the production of antibodies.</etype:comment>
        <etype:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/VO_0000001"/>
        <etype:label rdf:datatype="http://knowdive.disi.unitn.it/etype#string">Vaccine</etype:label>
    </owl:Class>
    


    <!-- http://knowdive.disi.unitn.it/etype#ViralProtein -->

    <owl:Class rdf:about="http://knowdive.disi.unitn.it/etype#ViralProtein">
        <etype:comment rdf:datatype="http://knowdive.disi.unitn.it/etype#string">Proteins encoded by viral genes.</etype:comment>
        <etype:isDefinedBy rdf:resource="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C17254"/>
        <etype:label rdf:datatype="http://knowdive.disi.unitn.it/etype#string">ViralProtein</etype:label>
    </owl:Class>
    


    <!-- http://knowdive.disi.unitn.it/etype#Virus -->

    <owl:Class rdf:about="http://knowdive.disi.unitn.it/etype#Virus">
        <etype:comment rdf:datatype="http://knowdive.disi.unitn.it/etype#string">Ultramicroscopic infectious agent that replicates itself only within cells of living hosts; many are pathogenic; a piece of nucleic acid (DNA or RNA) wrapped in a thin coat of protein.</etype:comment>
        <etype:isDefinedBy rdf:resource="http://purl.bioontology.org/ontology/STY/T005"/>
        <etype:label rdf:datatype="http://knowdive.disi.unitn.it/etype#string">Virus</etype:label>
    </owl:Class>
