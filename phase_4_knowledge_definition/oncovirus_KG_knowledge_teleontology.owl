        <rdfs:range rdf:resource="http://knowdive.disi.unitn.it/etype#string"/>
        <etype:comment rdf:datatype="http://knowdive.disi.unitn.it/etype#string">The broad functional class or grouping of a biological pathway.</etype:comment>
