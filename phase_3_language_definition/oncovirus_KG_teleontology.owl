    </owl:Class>
    


    <!-- https://w3id.org/oncovirus-kg#Virus -->

    <owl:Class rdf:about="https://w3id.org/oncovirus-kg#Virus">
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Ultramicroscopic infectious agent that replicates itself only within cells of living hosts; many are pathogenic; a piece of nucleic acid (DNA or RNA) wrapped in a thin coat of protein.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://purl.bioontology.org/ontology/STY/T005"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Virus</rdfs:label>
    </owl:Class>
